# Copy to .env and export these variables in your shell (the app reads process.env only).
# No variable is required. Without an API key the built-in planner is used for everything.

# Port and interface to listen on. The default host is loopback only.
PORT=3000
HOST=127.0.0.1

# Optional: enables AI generated ideas and the "Ask the planner" assistant.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional tuning
AI_TIMEOUT_MS=20000
RATE_LIMIT_MAX=120
AI_RATE_LIMIT_MAX=10
