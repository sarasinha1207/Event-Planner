{
  "name": "celebration-event-planner",
  "version": "1.0.0",
  "description": "A planning assistant for weddings, birthdays and community events: budgets, timelines, vendor checklists and personalised ideas.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=./src --watch-path=./public server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"public/js/**\" --test-coverage-exclude=\"public/js/main.js\" --test-coverage-lines=90 \"tests/**/*.test.js\"",
    "check": "node --check server.js && npm test"
  }
}
